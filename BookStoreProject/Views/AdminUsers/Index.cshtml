@model IEnumerable<BookStoreProject.DTOs.ApplicationUserDto>

@{
    ViewData["Title"] = "Manage Users";
}

<style>
    .users-page {
        min-height: calc(100vh - 70px);
        background: #f6f7fb;
        padding: 30px;
    }

    .users-container {
        max-width: 1250px;
        margin: auto;
    }

    /* HEADER */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
    }

    .page-title h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 750;
        color: #172033;
    }

    .page-title p {
        margin: 7px 0 0;
        color: #7a8497;
        font-size: 14px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 9px;
        background: white;
        border: 1px solid #e1e5ec;
        color: #475569;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

    .back-btn:hover {
        color: #4f46e5;
        background: #f8fafc;
    }

    /* STAT CARDS */

    .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 22px;
    }

    .stat-card {
        background: white;
        border: 1px solid #e8ebf2;
        border-radius: 14px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 5px 20px rgba(20,30,50,.04);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #eef2ff;
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .stat-label {
        color: #7a8497;
        font-size: 12px;
        font-weight: 650;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .stat-value {
        color: #263044;
        font-size: 23px;
        font-weight: 750;
        margin-top: 3px;
    }

    /* MAIN CARD */

    .users-card {
        background: white;
        border: 1px solid #e8ebf2;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(20,30,50,.04);
    }

    .card-toolbar {
        padding: 18px 20px;
        border-bottom: 1px solid #edf0f4;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .card-title {
        font-size: 17px;
        font-weight: 700;
        color: #263044;
    }

    .search-wrapper {
        position: relative;
        width: 300px;
    }

    .search-wrapper i {
        position: absolute;
        left: 13px;
        top: 11px;
        color: #9aa3b2;
    }

    .search-box {
        width: 100%;
        height: 40px;
        border: 1px solid #dfe3eb;
        border-radius: 8px;
        padding: 0 12px 0 38px;
        outline: none;
        box-sizing: border-box;
        font-size: 13px;
    }

    .search-box:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99,102,241,.1);
    }

    /* TABLE */

    .table-wrapper {
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 750px;
    }

    .users-table th {
        padding: 15px 20px;
        background: #f8f9fc;
        text-align: left;
        color: #7b8495;
        font-size: 11px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .5px;
        border-bottom: 1px solid #e9edf3;
    }

    .users-table td {
        padding: 17px 20px;
        border-bottom: 1px solid #eef1f5;
        vertical-align: middle;
    }

    .users-table tbody tr:hover {
        background: #fafbff;
    }

    /* USER */

    .user-info {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .avatar {
        width: 43px;
        height: 43px;
        border-radius: 50%;
        background: #eef2ff;
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
        font-weight: 750;
        flex-shrink: 0;
    }

    .user-name {
        font-weight: 650;
        color: #263044;
        font-size: 14px;
    }

    .user-email {
        color: #8a94a6;
        font-size: 12px;
        margin-top: 3px;
    }

    /* USER ID */

    .user-id {
        color: #64748b;
        font-size: 13px;
        font-family: monospace;
        background: #f8fafc;
        padding: 5px 8px;
        border-radius: 6px;
    }

    /* STATUS */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #ecfdf5;
        color: #047857;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        background: #10b981;
        border-radius: 50%;
    }

    /* EMPTY */

    .empty-state {
        padding: 70px 20px;
        text-align: center;
    }

    .empty-state i {
        font-size: 50px;
        color: #c5cad4;
    }

    .empty-state h3 {
        color: #475569;
        margin: 15px 0 7px;
    }

    .empty-state p {
        color: #94a3b8;
        font-size: 14px;
    }

    @@media(max-width: 800px) {

        .users-page {
            padding: 15px;
        }

        .stats {
            grid-template-columns: 1fr;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .card-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .search-wrapper {
            width: 100%;
        }
    }
</style>


<div class="users-page">

    <div class="users-container">

        <!-- HEADER -->

        <div class="page-header">

            <div class="page-title">

                <h1>Users</h1>

                <p>
                    View and manage registered bookstore customers.
                </p>

            </div>

            <a asp-controller="Admin"
               asp-action="Index"
               class="back-btn">

                <i class="bi bi-arrow-left"></i>

                Dashboard

            </a>

        </div>


        <!-- STATISTICS -->

        <div class="stats">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-people"></i>
                </div>

                <div>

                    <div class="stat-label">
                        Total Users
                    </div>

                    <div class="stat-value">
                        @(Model?.Count() ?? 0)
                    </div>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-person-check"></i>
                </div>

                <div>

                    <div class="stat-label">
                        Registered Customers
                    </div>

                    <div class="stat-value">
                        @(Model?.Count() ?? 0)
                    </div>

                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div>

                    <div class="stat-label">
                        Account Status
                    </div>

                    <div class="stat-value">
                        Active
                    </div>

                </div>

            </div>

        </div>


        <!-- USERS CARD -->

        <div class="users-card">

            <div class="card-toolbar">

                <div class="card-title">
                    Registered Users
                </div>

                <div class="search-wrapper">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           id="userSearch"
                           class="search-box"
                           placeholder="Search users..." />

                </div>

            </div>


            @if (Model != null && Model.Any())
            {
                <div class="table-wrapper">

                    <table class="users-table"
                           id="usersTable">

                        <thead>

                            <tr>

                                <th>
                                    User
                                </th>

                                <th>
                                    User ID
                                </th>

                                <th>
                                    Phone
                                </th>

                                <th>
                                    Account
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var user in Model)
                            {
                                var initial = !string.IsNullOrWhiteSpace(user.UserName)
                                    ? user.UserName.Substring(0, 1).ToUpper()
                                    : "?";

                                <tr>

                                    <!-- USER -->

                                    <td>

                                        <div class="user-info">

                                            <div class="avatar">
                                                @initial
                                            </div>

                                            <div>

                                                <div class="user-name">
                                                    @user.UserName
                                                </div>

                                                <div class="user-email">
                                                    @user.Email
                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- ID -->

                                    <td>

                                        <span class="user-id">
                                            #@user.Id
                                        </span>

                                    </td>


                                    <!-- PHONE -->

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(user.PhoneNumber))
                                        {
                                            <span style="color:#475569;font-size:13px;">
                                                <i class="bi bi-telephone"></i>
                                                @user.PhoneNumber
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#a0a8b6;font-size:13px;">
                                                Not provided
                                            </span>
                                        }

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <span class="status-badge">

                                            <span class="status-dot"></span>

                                            Active

                                        </span>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="empty-state">

                    <i class="bi bi-people"></i>

                    <h3>No users found</h3>

                    <p>
                        Registered customers will appear here.
                    </p>

                </div>
            }

        </div>

    </div>

</div>


<script>

    document.getElementById("userSearch")?.addEventListener("keyup", function () {

        const search = this.value.toLowerCase();

        document
            .querySelectorAll("#usersTable tbody tr")
            .forEach(row => {

                const text = row.innerText.toLowerCase();

                row.style.display =
                    text.includes(search) ? "" : "none";

            });

    });

</script>