@* @model BookStoreProject.DTOs.AdminDashboardDto

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .admin-page {
        background: #f5f7fb;
        min-height: calc(100vh - 70px);
        padding: 30px;
    }

    .dashboard-wrapper {
        max-width: 1400px;
        margin: auto;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

        .dashboard-header h1 {
            font-size: 30px;
            font-weight: 700;
            margin: 0;
            color: #1e293b;
        }

        .dashboard-header p {
            color: #64748b;
            margin-top: 6px;
        }

    .admin-badge {
        background: #eef2ff;
        color: #4f46e5;
        padding: 9px 16px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 600;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.06);
        border: 1px solid #e8edf5;
    }

    .stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        background: #eef2ff;
        color: #4f46e5;
    }

    .stat-title {
        color: #64748b;
        font-size: 14px;
        margin-top: 18px;
    }

    .stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
        margin-top: 5px;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 25px;
    }

    .panel {
        background: white;
        border-radius: 16px;
        border: 1px solid #e8edf5;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.05);
        padding: 24px;
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

        .panel-header h3 {
            margin: 0;
            color: #1e293b;
            font-size: 18px;
            font-weight: 700;
        }

        .panel-header span {
            font-size: 13px;
            color: #94a3b8;
        }

    .revenue-list {
        display: flex;
        flex-direction: column;
        gap: 17px;
    }

    .revenue-row {
        display: grid;
        grid-template-columns: 90px 1fr 100px;
        align-items: center;
        gap: 15px;
    }

    .month {
        font-size: 14px;
        color: #475569;
    }

    .progress {
        height: 9px;
        background: #eef2f7;
        border-radius: 20px;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        width: 70%;
        background: #6366f1;
        border-radius: 20px;
    }

    .revenue-value {
        text-align: right;
        font-weight: 600;
        color: #1e293b;
        font-size: 14px;
    }

    .sales-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .sale-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 15px;
        border-bottom: 1px solid #edf1f6;
    }

        .sale-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .book-info {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .book-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6366f1;
    }

    .book-name {
        font-size: 14px;
        font-weight: 600;
        color: #334155;
    }

    .copies {
        background: #eef2ff;
        color: #4f46e5;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
    }

    .quick-action {
        text-decoration: none;
        background: white;
        border: 1px solid #e8edf5;
        border-radius: 14px;
        padding: 20px;
        text-align: center;
        transition: 0.2s;
    }

        .quick-action:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(15, 23, 42, 0.08);
        }

        .quick-action i {
            font-size: 22px;
            color: #6366f1;
            margin-bottom: 10px;
        }

        .quick-action span {
            display: block;
            color: #334155;
            font-size: 14px;
            font-weight: 600;
        }

    @@media(max-width: 1000px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-grid {
            grid-template-columns: 1fr;
        }

        .quick-actions {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media(max-width: 600px) {
        .admin-page {
            padding: 15px;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .quick-actions {
            grid-template-columns: 1fr;
        }

        .dashboard-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }
    }
</style>

<div class="admin-page">

    <div class="dashboard-wrapper">

        <!-- HEADER -->
        <div class="dashboard-header">

            <div>
                <h1>Dashboard</h1>
                <p>Welcome back. Here's what's happening in your bookstore.</p>
            </div>

            <div class="admin-badge">
                <i class="bi bi-shield-check"></i>
                Administrator
            </div>

        </div>


        <!-- STATISTICS -->
        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon">
                        <i class="bi bi-currency-rupee"></i>
                    </div>
                </div>

                <div class="stat-title">
                    Total Revenue
                </div>

                <div class="stat-value">
                    ₹@Model.TotalRevenue.ToString("N2")
                </div>
            </div>


            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon">
                        <i class="bi bi-bag-check"></i>
                    </div>
                </div>

                <div class="stat-title">
                    Total Orders
                </div>

                <div class="stat-value">
                    @Model.TotalOrders
                </div>
            </div>


            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon">
                        <i class="bi bi-book"></i>
                    </div>
                </div>

                <div class="stat-title">
                    Books Sold
                </div>

                <div class="stat-value">
                    @Model.TotalBooksSold
                </div>
            </div>


            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>

                <div class="stat-title">
                    Sales Performance
                </div>

                <div class="stat-value">
                    Growing
                </div>
            </div>

        </div>


        <!-- CHART / SALES -->
        <div class="dashboard-grid">

            <!-- MONTHLY REVENUE -->
            <div class="panel">

                <div class="panel-header">
                    <h3>Monthly Revenue</h3>
                    <span>Revenue overview</span>
                </div>

                <div class="revenue-list">

                    @if (Model.MonthlyRevenue != null &&
                         Model.MonthlyRevenue.Any())
                    {
                        var maxRevenue = Model.MonthlyRevenue
                            .Max(x => x.Revenue);

                        foreach (var item in Model.MonthlyRevenue)
                        {
                            var percentage = maxRevenue > 0
                                ? (item.Revenue / maxRevenue) * 100
                                : 0;

                            <div class="revenue-row">

                                <div class="month">
                                    @item.Month
                                </div>

                                <div class="progress">
                                    <div class="progress-bar"
                                         style="width:@percentage%">
                                    </div>
                                </div>

                                <div class="revenue-value">
                                    ₹@item.Revenue.ToString("N0")
                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">
                            No revenue data available.
                        </p>
                    }

                </div>

            </div>


            <!-- TOP BOOKS -->
            <div class="panel">

                <div class="panel-header">
                    <h3>Top Books</h3>
                    <span>Best sellers</span>
                </div>

                <div class="sales-list">

                    @if (Model.BookSales != null &&
                         Model.BookSales.Any())
                    {
                        foreach (var item in Model.BookSales)
                        {
                            <div class="sale-item">

                                <div class="book-info">

                                    <div class="book-icon">
                                        <i class="bi bi-book"></i>
                                    </div>

                                    <div class="book-name">
                                        @item.BookName
                                    </div>

                                </div>

                                <div class="copies">
                                    @item.CopiesSold sold
                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">
                            No sales data available.
                        </p>
                    }

                </div>

            </div>

        </div>


        <!-- QUICK ACTIONS -->
        <div class="panel">

            <div class="panel-header">
                <h3>Quick Actions</h3>
                <span>Manage your bookstore</span>
            </div>

            <div class="quick-actions">

                <a asp-controller="AdminBooks"
                   asp-action="Index"
                   class="quick-action">

                    <i class="bi bi-book"></i>

                    <span>Manage Books</span>

                </a>


                <a asp-controller="AdminOrder"
                   asp-action="AdminManageOrders"
                   class="quick-action">

                    <i class="bi bi-box-seam"></i>

                    <span>Manage Orders</span>

                </a>


                <a asp-controller="AdminUsers"
                   asp-action="Index"
                   class="quick-action">

                    <i class="bi bi-people"></i>

                    <span>Manage Users</span>

                </a>


                <a asp-controller="AdminGenre"
                   asp-action="Index"
                   class="quick-action">

                    <i class="bi bi-tags"></i>

                    <span>Manage Genre</span>

                </a>

            </div>

        </div>

    </div>

</div> *@


