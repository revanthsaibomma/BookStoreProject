<div class="admin-page">

    <div class="dashboard-wrapper">

        <!-- HEADER -->
        <div class="dashboard-header">

            <div>
                <h1>Dashboard</h1>
                <p>Welcome back. Here's what's happening in your bookstore.</p>
            </div>

            <div class="admin-badge">
                <i class="bi bi-shield-check"></i>
                Administrator
            </div>

        </div>


        <!-- STATISTICS -->
        <div class="stats-grid">

            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon">
                        <i class="bi bi-currency-rupee"></i>
                    </div>
                </div>

                <div class="stat-title">
                    Total Revenue
                </div>

                <div class="stat-value">
                    ₹@Model.TotalRevenue.ToString("N2")
                </div>
            </div>


            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon">
                        <i class="bi bi-bag-check"></i>
                    </div>
                </div>

                <div class="stat-title">
                    Total Orders
                </div>

                <div class="stat-value">
                    @Model.TotalOrders
                </div>
            </div>


            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon">
                        <i class="bi bi-book"></i>
                    </div>
                </div>

                <div class="stat-title">
                    Books Sold
                </div>

                <div class="stat-value">
                    @Model.TotalBooksSold
                </div>
            </div>


            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>

                <div class="stat-title">
                    Sales Performance
                </div>

                <div class="stat-value">
                    Growing
                </div>
            </div>

        </div>


        <!-- =========================================================
     DASHBOARD CHARTS
     ========================================================= -->

        <div class="charts-grid">

            <!-- MONTHLY REVENUE CHART -->
            <div class="chart-panel">

                <div class="chart-header">

                    <div>
                        <h3>Monthly Revenue</h3>
                        <span>Revenue performance over time</span>
                    </div>

                    <div class="chart-icon">
                        <i class="bi bi-graph-up"></i>
                    </div>

                </div>

                @if (Model.MonthlyRevenue != null &&
                     Model.MonthlyRevenue.Any())
                {
                    <div class="chart-container">
                        <canvas id="revenueChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="empty-chart">

                        <i class="bi bi-bar-chart"></i>

                        <strong>No revenue data available</strong>

                        <span>
                            Revenue will appear here after orders are placed.
                        </span>

                    </div>
                }

            </div>


            <!-- GENRE PIE CHART -->
            <div class="chart-panel">

                <div class="chart-header">

                    <div>
                        <h3>Sales by Genre</h3>
                        <span>Books sold by category</span>
                    </div>

                    <div class="chart-icon">
                        <i class="bi bi-pie-chart"></i>
                    </div>

                </div>

                @if (Model.GenreSales != null &&
                     Model.GenreSales.Any())
                {
                    <div class="chart-container">
                        <canvas id="genreChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="empty-chart">

                        <i class="bi bi-pie-chart"></i>

                        <strong>No genre data available</strong>

                        <span>
                            Genre sales will appear here after orders.
                        </span>

                    </div>
                }

            </div>


            <!-- TOP BOOKS BAR CHART -->
            <div class="chart-panel top-books-panel">

                <div class="chart-header">

                    <div>
                        <h3>Top Selling Books</h3>
                        <span>Best performing books in your store</span>
                    </div>

                    <div class="chart-icon">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>

                </div>

                @if (Model.BookSales != null &&
                     Model.BookSales.Any())
                {
                    <div class="chart-container">
                        <canvas id="booksChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="empty-chart">

                        <i class="bi bi-book"></i>

                        <strong>No sales data available</strong>

                        <span>
                            Top selling books will appear here after orders.
                        </span>

                    </div>
                }

            </div>

        </div>

        <script>

                    document.addEventListener("DOMContentLoaded", function() {

                        // =====================================================
                        // MONTHLY REVENUE CHART
                        // =====================================================

                        const revenueCanvas =
                            document.getElementById("revenueChart");

                        if (revenueCanvas) {

                            const revenueLabels = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyRevenue.Select(x => x.Month)));

                            const revenueData =
                        @Html.Raw(JsonSerializer.Serialize(
                                Model.MonthlyRevenue.Select(x => x.Revenue)
                                        ));

                            new Chart(revenueCanvas, {

                                type: "line",

                                data: {
                                    labels: revenueLabels,

                                    datasets: [{
                                        label: "Revenue",

                                        data: revenueData,

                                        borderColor: "#dca952",

                                        backgroundColor: "rgba(220, 169, 82, 0.12)",

                                        borderWidth: 3,

                                        tension: 0.4,

                                        fill: true,

                                        pointRadius: 4,

                                        pointHoverRadius: 7
                                    }]
                                },

                                options: {

                                    responsive: true,

                                    maintainAspectRatio: false,

                                    plugins: {

                                        legend: {
                                            display: false
                                        },

                                        tooltip: {
                                            callbacks: {

                                                label: function(context) {

                                                    return " ₹" +
                                                        Number(context.raw)
                                                            .toLocaleString("en-IN");

                                                }

                                            }
                                        }

                                    },

                                    scales: {

                                        y: {
                                            beginAtZero: true,

                                            ticks: {
                                                callback: function(value) {

                                                    return "₹" +
                                                        Number(value)
                                                            .toLocaleString("en-IN");

                                                }
                                            },

                                            grid: {
                                                color: "#eef2f7"
                                            }
                                        },

                                        x: {

                                            grid: {
                                                display: false
                                            }

                                        }

                                    }

                                }

                            });

                        }


                        // =====================================================
                        // GENRE PIE CHART
                        // =====================================================

                        const genreCanvas =
                            document.getElementById("genreChart");

                        if (genreCanvas) {

                            const genreLabels = @Html.Raw(JsonSerializer.Serialize(Model.GenreSales.Select(x => x.GenreName)));

                            const genreData =
                        @Html.Raw(JsonSerializer.Serialize(
                                Model.GenreSales.Select(x => x.CopiesSold)
                                        ));

                            new Chart(genreCanvas, {

                                type: "doughnut",

                                data: {

                                    labels: genreLabels,

                                    datasets: [{

                                        data: genreData,

                                        backgroundColor: [
                                            "#EF4444",  // Red
                                            "#3B82F6",  // Blue
                                            "#22C55E",  // Green
                                            "#8B5CF6",  // Purple
                                            "#F59E0B"   // Yellow
                                        ],

                                        borderWidth: 3,

                                        borderColor: "#ffffff",

                                        hoverOffset: 8

                                    }]

                                },

                                options: {

                                    responsive: true,

                                    maintainAspectRatio: false,

                                    cutout: "62%",

                                    plugins: {

                                        legend: {

                                            position: "bottom",

                                            labels: {

                                                padding: 15,

                                                usePointStyle: true

                                            }

                                        }

                                    }

                                }

                            });

                        }


                        // =====================================================
                        // TOP BOOKS BAR CHART
                        // =====================================================

                        const booksCanvas =
                            document.getElementById("booksChart");

                        if (booksCanvas) {

                            const bookLabels = @Html.Raw(JsonSerializer.Serialize(Model.BookSales.Select(x => x.BookName)));

                            const bookData =
                        @Html.Raw(JsonSerializer.Serialize(
                                Model.BookSales.Select(x => x.CopiesSold)
                                        ));

                            new Chart(booksCanvas, {

                                type: "bar",

                                data: {

                                    labels: bookLabels,

                                    datasets: [{

                                        label: "Copies Sold",

                                        data: bookData,

                                        backgroundColor: [
                                            "#EF4444",
                                            "#3B82F6",
                                            "#22C55E",
                                            "#8B5CF6",
                                            "#F59E0B"
                                        ],


                                        borderRadius: 8,

                                        borderSkipped: false

                                    }]

                                },

                                options: {

                                    responsive: true,

                                    maintainAspectRatio: false,

                                    plugins: {

                                        legend: {
                                            display: false
                                        }

                                    },

                                    scales: {

                                        y: {

                                            beginAtZero: true,

                                            ticks: {

                                                stepSize: 1

                                            },

                                            grid: {

                                                color: "#eef2f7"

                                            }

                                        },

                                        x: {

                                            grid: {
                                                display: false
                                            }

                                        }

                                    }

                                }

                            });

                        }

                    });

        </script>


        <!-- QUICK ACTIONS -->
        <div class="panel">

            <div class="panel-header">
                <h3>Quick Actions</h3>
                <span>Manage your bookstore</span>
            </div>

            <div class="quick-actions">

                <a asp-controller="AdminBooks"
                   asp-action="Index"
                   class="quick-action">

                    <i class="bi bi-book"></i>

                    <span>Manage Books</span>

                </a>


                <a asp-controller="AdminOrder"
                   asp-action="AdminManageOrders"
                   class="quick-action">

                    <i class="bi bi-box-seam"></i>

                    <span>Manage Orders</span>

                </a>


                <a asp-controller="AdminUsers"
                   asp-action="Index"
                   class="quick-action">

                    <i class="bi bi-people"></i>

                    <span>Manage Users</span>

                </a>


                <a asp-controller="AdminGenre"
                   asp-action="Index"
                   class="quick-action">

                    <i class="bi bi-tags"></i>

                    <span>Manage Genre</span>

                </a>

            </div>

        </div>

    </div>

</div>