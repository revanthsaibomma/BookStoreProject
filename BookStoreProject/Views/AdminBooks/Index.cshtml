@model IEnumerable<BookStoreProject.DTOs.BookDto>

@{
    ViewData["Title"] = "Manage Books";
}

<style>
    .books-page {
        background: #f6f7fb;
        min-height: calc(100vh - 70px);
        padding: 30px;
    }

    .books-container {
        max-width: 1400px;
        margin: auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-title h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 750;
        color: #172033;
    }

    .page-title p {
        margin: 7px 0 0;
        color: #7a8497;
        font-size: 14px;
    }

    .add-book-btn {
        background: #4f46e5;
        color: white;
        padding: 12px 19px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: .2s;
    }

        .add-book-btn:hover {
            background: #4338ca;
            color: white;
            transform: translateY(-1px);
        }

    .toolbar {
        background: white;
        padding: 18px;
        border-radius: 14px;
        border: 1px solid #e8ebf2;
        margin-bottom: 20px;
        display: flex;
        justify-content: space-between;
        gap: 15px;
    }

    .search-box {
        position: relative;
        width: 350px;
    }

        .search-box i {
            position: absolute;
            left: 14px;
            top: 12px;
            color: #9aa3b2;
        }

        .search-box input {
            width: 100%;
            height: 42px;
            border: 1px solid #dfe3eb;
            border-radius: 9px;
            padding: 0 15px 0 40px;
            outline: none;
        }

            .search-box input:focus {
                border-color: #6366f1;
                box-shadow: 0 0 0 3px rgba(99,102,241,.1);
            }

    .books-card {
        background: white;
        border: 1px solid #e8ebf2;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(20,30,50,.04);
    }

    .books-table {
        width: 100%;
        border-collapse: collapse;
    }

        .books-table thead {
            background: #f8f9fc;
        }

        .books-table th {
            text-align: left;
            padding: 16px 18px;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #7b8495;
            font-weight: 700;
            border-bottom: 1px solid #e9edf3;
        }

        .books-table td {
            padding: 16px 18px;
            border-bottom: 1px solid #eef1f5;
            vertical-align: middle;
        }

        .books-table tbody tr:hover {
            background: #fafbff;
        }

    .book-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .book-cover {
        width: 52px;
        height: 68px;
        border-radius: 7px;
        object-fit: cover;
        background: #eef1f6;
        box-shadow: 0 3px 8px rgba(0,0,0,.08);
    }

    .book-cover-placeholder {
        width: 52px;
        height: 68px;
        border-radius: 7px;
        background: #eef1f6;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #8c96a7;
        font-size: 20px;
    }

    .book-name {
        font-weight: 650;
        color: #263044;
        margin-bottom: 4px;
    }

    .author {
        color: #8a94a6;
        font-size: 13px;
    }

    .price {
        font-weight: 700;
        color: #273044;
    }

    .genre-badge {
        display: inline-block;
        padding: 5px 10px;
        background: #eef2ff;
        color: #4f46e5;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .stock {
        font-weight: 600;
        font-size: 13px;
    }

    .stock-good {
        color: #16803c;
    }

    .stock-low {
        color: #d97706;
    }

    .stock-out {
        color: #dc2626;
    }

    .actions {
        display: flex;
        gap: 7px;
    }

    .action-btn {
        width: 35px;
        height: 35px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .2s;
    }

    .view-btn {
        background: #eef2ff;
        color: #4f46e5;
    }

    .edit-btn {
        background: #ecfdf5;
        color: #059669;
    }

    .delete-btn {
        background: #fef2f2;
        color: #dc2626;
    }

    .action-btn:hover {
        transform: translateY(-2px);
    }

    .empty-state {
        text-align: center;
        padding: 70px 20px;
    }

        .empty-state i {
            font-size: 50px;
            color: #c5cad4;
        }

        .empty-state h3 {
            color: #475569;
            margin-top: 15px;
        }

        .empty-state p {
            color: #94a3b8;
        }

    @@media(max-width: 900px) {
        .books-page {
            padding: 15px;
        }

        .books-card {
            overflow-x: auto;
        }

        .books-table {
            min-width: 900px;
        }

        .toolbar {
            flex-direction: column;
        }

        .search-box {
            width: 100%;
        }
    }

    @@media(max-width: 600px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }
    }
</style>

<div class="books-page">

    <div class="books-container">

        <!-- HEADER -->
        <div class="page-header">

            <div class="page-title">
                <h1>Books</h1>
                <p>Manage your bookstore inventory and catalog.</p>
            </div>

            <a asp-action="Create" class="add-book-btn">
                <i class="bi bi-plus-lg"></i>
                Add New Book
            </a>

        </div>


        <!-- TOOLBAR -->
        <div class="toolbar">

            <div class="search-box">
                <i class="bi bi-search"></i>

                <input type="text"
                       id="bookSearch"
                       placeholder="Search books or authors..." />
            </div>

            <div>
                <span style="color:#7b8495;font-size:14px;">
                    Total Books:
                </span>

                <strong style="color:#263044;">
                    @Model.Count()
                </strong>
            </div>

        </div>


        <!-- BOOK TABLE -->
        <div class="books-card">

            @if (Model != null && Model.Any())
            {
                <table class="books-table" id="booksTable">

                    <thead>
                        <tr>
                            <th>Book</th>
                            <th>Genre</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var book in Model)
                        {
                            <tr>

                                <td>
                                    <div class="book-info">

                                        @if (!string.IsNullOrEmpty(book.Image))
                                        {
                                            <img src="@book.Image"
                                                 class="book-cover"
                                                 alt="@book.BookName" />
                                        }
                                        else
                                        {
                                            <div class="book-cover-placeholder">
                                                <i class="bi bi-book"></i>
                                            </div>
                                        }

                                        <div>
                                            <div class="book-name">
                                                @book.BookName
                                            </div>

                                            <div class="author">
                                                @book.AuthorName
                                            </div>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <span class="genre-badge">
                                        @book.GenreName
                                    </span>
                                </td>

                                <td>
                                    <span class="price">
                                        ₹@book.Price.ToString("N2")
                                    </span>
                                </td>

                                <td>

                                    @if (book.Stock == 0)
                                    {
                                        <span class="stock stock-out">
                                            Out of stock
                                        </span>
                                    }
                                    else if (book.Stock <= 5)
                                    {
                                        <span class="stock stock-low">
                                            @book.Stock left
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="stock stock-good">
                                            @book.Stock available
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="actions">

                                        <a asp-action="Details"
                                           asp-route-id="@book.BookId"
                                           class="action-btn view-btn"
                                           title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@book.BookId"
                                           class="action-btn edit-btn"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@book.BookId"
                                           class="action-btn delete-btn"
                                           title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-state">

                    <i class="bi bi-bookshelf"></i>

                    <h3>No books found</h3>

                    <p>
                        Start building your bookstore by adding your first book.
                    </p>

                    <a asp-action="Create"
                       class="add-book-btn">
                        <i class="bi bi-plus-lg"></i>
                        Add Book
                    </a>

                </div>
            }

        </div>

    </div>

</div>


<script>
    document.getElementById("bookSearch")?.addEventListener("keyup", function () {

        const search = this.value.toLowerCase();

        document.querySelectorAll("#booksTable tbody tr")
            .forEach(row => {

                const text = row.innerText.toLowerCase();

                row.style.display =
                    text.includes(search) ? "" : "none";
            });
    });
</script>