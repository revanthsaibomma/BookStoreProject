@model BookStoreProject.DTOs.UpdateBookDto

@{
    ViewData["Title"] = "Edit Book";
}

<style>
    .edit-page {
        background: #f6f7fb;
        min-height: calc(100vh - 70px);
        padding: 35px 20px;
    }

    .edit-container {
        max-width: 850px;
        margin: auto;
    }

    .edit-header {
        margin-bottom: 25px;
    }

        .edit-header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 750;
            color: #172033;
        }

        .edit-header p {
            color: #7a8497;
            margin-top: 7px;
        }

    .edit-card {
        background: white;
        border: 1px solid #e8ebf2;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 6px 25px rgba(20,30,50,.05);
    }

    .book-id {
        display: inline-block;
        background: #eef2ff;
        color: #4f46e5;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .full {
        grid-column: 1 / -1;
    }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 650;
        color: #475569;
        margin-bottom: 7px;
    }

    .form-control {
        width: 100%;
        height: 45px;
        border: 1px solid #dfe3eb;
        border-radius: 9px;
        padding: 0 13px;
        outline: none;
        box-sizing: border-box;
    }

    textarea.form-control {
        height: 120px;
        padding-top: 12px;
        resize: vertical;
    }

    .form-control:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99,102,241,.1);
    }

    .text-danger {
        display: block;
        color: #dc2626;
        font-size: 12px;
        margin-top: 5px;
    }

    .actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        border-top: 1px solid #edf0f4;
        padding-top: 20px;
        margin-top: 10px;
    }

    .btn {
        padding: 11px 20px;
        border-radius: 9px;
        text-decoration: none;
        border: none;
        font-weight: 650;
        cursor: pointer;
    }

    .btn-save {
        background: #4f46e5;
        color: white;
    }

        .btn-save:hover {
            background: #4338ca;
            color: white;
        }

    .btn-cancel {
        background: #f1f3f7;
        color: #475569;
    }

    @@media(max-width:700px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .full {
            grid-column: auto;
        }

        .edit-card {
            padding: 20px;
        }
    }
</style>

<div class="edit-page">

    <div class="edit-container">

        <div class="edit-header">
            <h1>Edit Book</h1>
            <p>Update the information for this book.</p>
        </div>

        <div class="edit-card">

            <span class="book-id">
                Book ID: @Model.BookId
            </span>

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="BookId" />

                <div class="form-grid">

                    <div class="form-group">

                        <label asp-for="BookName"
                               class="form-label">
                            Book Name
                        </label>

                        <input asp-for="BookName"
                               class="form-control" />

                        <span asp-validation-for="BookName"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group">

                        <label asp-for="AuthorName"
                               class="form-label">
                            Author Name
                        </label>

                        <input asp-for="AuthorName"
                               class="form-control" />

                        <span asp-validation-for="AuthorName"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group">

                        <label asp-for="Price"
                               class="form-label">
                            Price
                        </label>

                        <input asp-for="Price"
                               type="number"
                               step="0.01"
                               class="form-control" />

                        <span asp-validation-for="Price"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group">

                        <label asp-for="GenreId"
                               class="form-label">
                            Genre ID
                        </label>

                        <input asp-for="GenreId"
                               type="number"
                               class="form-control" />

                        <span asp-validation-for="GenreId"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group">

                        <label asp-for="Stock"
                               class="form-label">
                            Stock
                        </label>

                        <input asp-for="Stock"
                               type="number"
                               class="form-control" />

                        <span asp-validation-for="Stock"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group">

                        <label asp-for="Image"
                               class="form-label">
                            Image URL
                        </label>

                        <input asp-for="Image"
                               class="form-control" />

                        <span asp-validation-for="Image"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group full">

                        <label asp-for="Description"
                               class="form-label">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>

                    </div>

                </div>


                <div class="actions">

                    <a asp-action="Index"
                       class="btn btn-cancel">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-save">
                        <i class="bi bi-save"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}