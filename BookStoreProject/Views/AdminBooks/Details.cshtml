@model BookStoreProject.DTOs.BookDto

@{
    ViewData["Title"] = "Book Details";
}

<style>
    .details-page {
        background: #f6f7fb;
        min-height: calc(100vh - 70px);
        padding: 35px 20px;
    }

    .details-container {
        max-width: 1000px;
        margin: auto;
    }

    .back-link {
        text-decoration: none;
        color: #64748b;
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 20px;
    }

        .back-link:hover {
            color: #4f46e5;
        }

    .details-card {
        background: white;
        border-radius: 18px;
        border: 1px solid #e8ebf2;
        padding: 35px;
        box-shadow: 0 7px 28px rgba(20,30,50,.05);
    }

    .book-layout {
        display: grid;
        grid-template-columns: 240px 1fr;
        gap: 40px;
    }

    .book-image {
        width: 220px;
        height: 300px;
        object-fit: cover;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0,0,0,.12);
    }

    .image-placeholder {
        width: 220px;
        height: 300px;
        background: #eef1f6;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 60px;
        color: #a6afbd;
    }

    .book-title {
        font-size: 32px;
        font-weight: 750;
        color: #172033;
        margin: 0 0 7px;
    }

    .author {
        color: #7a8497;
        font-size: 15px;
        margin-bottom: 20px;
    }

    .genre {
        display: inline-block;
        padding: 6px 12px;
        background: #eef2ff;
        color: #4f46e5;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 650;
        margin-bottom: 20px;
    }

    .price {
        font-size: 27px;
        font-weight: 750;
        color: #263044;
        margin-bottom: 20px;
    }

    .description-title {
        font-size: 14px;
        font-weight: 700;
        color: #334155;
        margin-bottom: 7px;
    }

    .description {
        color: #64748b;
        line-height: 1.7;
        font-size: 14px;
    }

    .stock-box {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 20px;
        padding: 9px 14px;
        background: #ecfdf5;
        color: #047857;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 650;
    }

    .actions {
        display: flex;
        gap: 10px;
        margin-top: 30px;
        padding-top: 22px;
        border-top: 1px solid #edf0f4;
    }

    .btn {
        padding: 11px 18px;
        border-radius: 9px;
        text-decoration: none;
        font-weight: 650;
        font-size: 14px;
    }

    .btn-edit {
        background: #4f46e5;
        color: white;
    }

        .btn-edit:hover {
            background: #4338ca;
            color: white;
        }

    .btn-delete {
        background: #fef2f2;
        color: #dc2626;
    }

    .btn-back {
        background: #f1f3f7;
        color: #475569;
    }

    @@media(max-width:700px) {
        .book-layout {
            grid-template-columns: 1fr;
        }

        .book-image,
        .image-placeholder {
            width: 180px;
            height: 250px;
        }

        .details-card {
            padding: 22px;
        }

        .book-title {
            font-size: 26px;
        }
    }
</style>

<div class="details-page">

    <div class="details-container">

        <a asp-action="Index"
           class="back-link">
            <i class="bi bi-arrow-left"></i>
            Back to Books
        </a>

        <div class="details-card">

            <div class="book-layout">

                <div>

                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="@Model.Image"
                             class="book-image"
                             alt="@Model.BookName" />
                    }
                    else
                    {
                        <div class="image-placeholder">
                            <i class="bi bi-book"></i>
                        </div>
                    }

                </div>


                <div>

                    <span class="genre">
                        @Model.GenreName
                    </span>

                    <h1 class="book-title">
                        @Model.BookName
                    </h1>

                    <div class="author">
                        by @Model.AuthorName
                    </div>

                    <div class="price">
                        ₹@Model.Price.ToString("N2")
                    </div>

                    <div class="description-title">
                        Description
                    </div>

                    <div class="description">
                        @Model.Description
                    </div>

                    <div class="stock-box">

                        <i class="bi bi-box-seam"></i>

                        @Model.Stock copies currently in stock

                    </div>

                </div>

            </div>


            <div class="actions">

                <a asp-action="Edit"
                   asp-route-id="@Model.BookId"
                   class="btn btn-edit">
                    <i class="bi bi-pencil"></i>
                    Edit Book
                </a>

                <a asp-action="Delete"
                   asp-route-id="@Model.BookId"
                   class="btn btn-delete">
                    <i class="bi bi-trash"></i>
                    Delete
                </a>

                <a asp-action="Index"
                   class="btn btn-back">
                    Back
                </a>

            </div>

        </div>

    </div>

</div>