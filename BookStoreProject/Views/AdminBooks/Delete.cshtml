@model BookStoreProject.DTOs.BookDto

@{
    ViewData["Title"] = "Delete Book";
}

<style>
    .delete-page {
        background: #f6f7fb;
        min-height: calc(100vh - 70px);
        padding: 60px 20px;
    }

    .delete-container {
        max-width: 600px;
        margin: auto;
    }

    .delete-card {
        background: white;
        border-radius: 18px;
        padding: 35px;
        border: 1px solid #f1dede;
        box-shadow: 0 8px 30px rgba(20,30,50,.06);
        text-align: center;
    }

    .warning-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: #fef2f2;
        color: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 30px;
    }

    .delete-card h1 {
        color: #172033;
        font-size: 25px;
        margin-bottom: 10px;
    }

    .warning-text {
        color: #64748b;
        font-size: 14px;
        line-height: 1.6;
        margin-bottom: 25px;
    }

    .book-preview {
        background: #f8f9fc;
        border-radius: 12px;
        padding: 15px;
        display: flex;
        align-items: center;
        gap: 15px;
        text-align: left;
        margin-bottom: 25px;
    }

        .book-preview img {
            width: 55px;
            height: 72px;
            object-fit: cover;
            border-radius: 7px;
        }

    .book-placeholder {
        width: 55px;
        height: 72px;
        border-radius: 7px;
        background: #e5e9f0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #8993a3;
    }

    .book-name {
        font-weight: 700;
        color: #263044;
    }

    .author {
        color: #8a94a6;
        font-size: 13px;
        margin-top: 4px;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn {
        padding: 11px 20px;
        border-radius: 9px;
        border: none;
        text-decoration: none;
        font-size: 14px;
        font-weight: 650;
        cursor: pointer;
    }

    .btn-delete {
        background: #dc2626;
        color: white;
    }

        .btn-delete:hover {
            background: #b91c1c;
        }

    .btn-cancel {
        background: #f1f3f7;
        color: #475569;
    }
</style>

<div class="delete-page">

    <div class="delete-container">

        <div class="delete-card">

            <div class="warning-icon">
                <i class="bi bi-trash3"></i>
            </div>

            <h1>Delete this book?</h1>

            <p class="warning-text">
                This action cannot be undone.
                Are you sure you want to permanently remove
                this book from your bookstore?
            </p>


            <div class="book-preview">

                @if (!string.IsNullOrEmpty(Model.Image))
                {
                    <img src="@Model.Image"
                         alt="@Model.BookName" />
                }
                else
                {
                    <div class="book-placeholder">
                        <i class="bi bi-book"></i>
                    </div>
                }

                <div>

                    <div class="book-name">
                        @Model.BookName
                    </div>

                    <div class="author">
                        by @Model.AuthorName
                    </div>

                </div>

            </div>


            <form asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.BookId" />

                <div class="actions">

                    <a asp-action="Index"
                       class="btn btn-cancel">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-delete">
                        <i class="bi bi-trash3"></i>
                        Yes, Delete Book
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>