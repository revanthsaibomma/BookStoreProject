@model BookStoreProject.DTOs.CreateBookDto

@{
    ViewData["Title"] = "Add Book";
}

<style>
    .form-page {
        background: #f6f7fb;
        min-height: calc(100vh - 70px);
        padding: 35px 20px;
    }

    .form-container {
        max-width: 850px;
        margin: auto;
    }

    .form-header {
        margin-bottom: 25px;
    }

        .form-header h1 {
            margin: 0;
            font-size: 28px;
            color: #172033;
            font-weight: 750;
        }

        .form-header p {
            color: #7a8497;
            margin-top: 7px;
        }

    .form-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        border: 1px solid #e8ebf2;
        box-shadow: 0 6px 25px rgba(20,30,50,.05);
    }

    .section-title {
        font-size: 16px;
        font-weight: 700;
        color: #263044;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid #edf0f4;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        margin-bottom: 18px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-label {
        font-size: 13px;
        font-weight: 650;
        color: #475569;
        margin-bottom: 7px;
        display: block;
    }

    .form-control,
    .form-select {
        width: 100%;
        height: 45px;
        border: 1px solid #dfe3eb;
        border-radius: 9px;
        padding: 0 13px;
        outline: none;
        font-size: 14px;
        box-sizing: border-box;
    }

    textarea.form-control {
        height: 120px;
        padding-top: 12px;
        resize: vertical;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99,102,241,.1);
    }

    .text-danger {
        font-size: 12px;
        color: #dc2626;
        margin-top: 5px;
        display: block;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #edf0f4;
    }

    .btn {
        border: none;
        border-radius: 9px;
        padding: 11px 20px;
        font-size: 14px;
        font-weight: 650;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-primary {
        background: #4f46e5;
        color: white;
    }

        .btn-primary:hover {
            background: #4338ca;
            color: white;
        }

    .btn-secondary {
        background: #f1f3f7;
        color: #475569;
    }

        .btn-secondary:hover {
            background: #e5e7eb;
            color: #334155;
        }

    @@media(max-width: 700px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }

        .form-card {
            padding: 20px;
        }
    }
</style>

<div class="form-page">

    <div class="form-container">

        <div class="form-header">
            <h1>Add New Book</h1>
            <p>Add a new title to your bookstore catalog.</p>
        </div>

        <div class="form-card">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div class="section-title">
                    <i class="bi bi-book"></i>
                    Book Information
                </div>

                <div class="form-grid">

                    <div class="form-group">

                        <label asp-for="BookName"
                               class="form-label">
                            Book Name
                        </label>

                        <input asp-for="BookName"
                               class="form-control"
                               placeholder="Enter book name" />

                        <span asp-validation-for="BookName"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group">

                        <label asp-for="AuthorName"
                               class="form-label">
                            Author Name
                        </label>

                        <input asp-for="AuthorName"
                               class="form-control"
                               placeholder="Enter author name" />

                        <span asp-validation-for="AuthorName"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group">

                        <label asp-for="Price"
                               class="form-label">
                            Price
                        </label>

                        <input asp-for="Price"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="0.00" />

                        <span asp-validation-for="Price"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group">

                        <label asp-for="GenreId"
                               class="form-label">
                            Genre ID
                        </label>

                        <input asp-for="GenreId"
                               type="number"
                               class="form-control"
                               placeholder="Enter genre ID" />

                        <span asp-validation-for="GenreId"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group">

                        <label asp-for="Stock"
                               class="form-label">
                            Stock Quantity
                        </label>

                        <input asp-for="Stock"
                               type="number"
                               class="form-control"
                               placeholder="Enter stock quantity" />

                        <span asp-validation-for="Stock"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group">

                        <label asp-for="Image"
                               class="form-label">
                            Book Image URL
                        </label>

                        <input asp-for="Image"
                               class="form-control"
                               placeholder="https://..." />

                        <span asp-validation-for="Image"
                              class="text-danger"></span>

                    </div>


                    <div class="form-group full-width">

                        <label asp-for="Description"
                               class="form-label">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  placeholder="Write a short description of the book..."></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger"></span>

                    </div>

                </div>


                <div class="form-actions">

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-check-lg"></i>
                        Add Book
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}