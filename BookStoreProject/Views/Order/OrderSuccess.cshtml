@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="success-page">

    <div class="success-card">

        <!-- Success Icon -->
        <div class="success-icon">
            <i class="bi bi-check-lg"></i>
        </div>

        <!-- Heading -->
        <div class="success-badge">
            ORDER SUCCESSFUL
        </div>

        <h1>Order Confirmed!</h1>

        <p class="success-message">
            Thank you for shopping with BookNest.
            Your order has been successfully placed.
        </p>

        <p class="success-submessage">
            We've received your order and it will be processed shortly.
        </p>

        <!-- Order Number -->
        <div class="order-number-box">
            <span>ORDER NUMBER</span>
            <strong>#@ViewBag.OrderId</strong>
        </div>

        <!-- Divider -->
        <div class="success-divider"></div>

        <!-- Buttons -->
        <div class="success-actions">

            <a asp-controller="Order"
               asp-action="History"
               class="success-btn primary">
                <i class="bi bi-box-seam"></i>
                View My Orders
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               class="success-btn secondary">
                <i class="bi bi-book"></i>
                Continue Shopping
            </a>

        </div>

        <!-- Bottom note -->
        <div class="success-note">
            <i class="bi bi-shield-check"></i>
            <span>Your order details are safely stored with BookNest.</span>
        </div>

    </div>

</div>