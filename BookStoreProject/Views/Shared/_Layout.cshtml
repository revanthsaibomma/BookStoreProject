<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BookNest</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body class="@(ViewContext.RouteData.Values["area"]?.ToString() == "Identity" ? "identity-page" : "")">

<header>

    <nav class="navbar navbar-expand-lg border-bottom">

        <div class="container">

            <!-- Brand -->
            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">

                <i class="bi bi-book-half me-2"></i>
                BookNest

            </a>


            <!-- Mobile menu -->
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>


            <div class="collapse navbar-collapse" id="mainNavbar">

                <!-- Left Navigation -->

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">

                            <i class="bi bi-house me-1"></i>
                            Home

                        </a>

                    </li>


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Order"
                               asp-action="History">

                                <i class="bi bi-box-seam me-1"></i>
                                My Orders

                            </a>

                        </li>
                    }

                </ul>


                <!-- Right Navigation -->

                <ul class="navbar-nav align-items-lg-center gap-lg-2">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- Cart -->

                        <li class="nav-item">

                            <a class="nav-link position-relative"
                               asp-controller="Cart"
                               asp-action="Index">

                                <i class="bi bi-cart3 fs-5"></i>
                                Cart

                            </a>

                        </li>


                        <!-- Admin -->

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">

                                <a class="btn btn-outline-primary btn-sm px-3"
                                   asp-controller="Admin"
                                   asp-action="Index">

                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Admin Dashboard

                                </a>

                            </li>
                        }


                        <!-- Account -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">

                                <i class="bi bi-person-circle me-1"></i>
                                @User.Identity.Name

                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                                <li>

                                    <a class="dropdown-item"
                                       asp-area="Identity"
                                       asp-page="/Account/Manage/Index">

                                        <i class="bi bi-person me-2"></i>
                                        My Account

                                    </a>

                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>

                                    <form asp-area="Identity"
                                          asp-page="/Account/Logout"
                                          method="post">

                                        <button type="submit"
                                                class="dropdown-item text-danger">

                                            <i class="bi bi-box-arrow-right me-2"></i>
                                            Logout

                                        </button>

                                    </form>

                                </li>

                            </ul>

                        </li>
                    }
                    else
                    {
                        <!-- Login -->

                        <li class="nav-item">

                            <a class="btn btn-outline-primary px-3"
                               asp-area="Identity"
                               asp-page="/Account/Login">

                                <i class="bi bi-box-arrow-in-right me-1"></i>
                                Login

                            </a>

                        </li>


                        <!-- Register -->

                        <li class="nav-item">

                            <a class="btn btn-primary px-3"
                               asp-area="Identity"
                               asp-page="/Account/Register">

                                <i class="bi bi-person-plus me-1"></i>
                                Register

                            </a>

                        </li>
                    }

                </ul>

            </div>

        </div>

    </nav>

</header>


<main>
    @RenderBody()
</main>

<!-- Floating AI Assistant Button -->
<a asp-controller="Chat"
   asp-action="Index"
   class="ai-assistant-button"
   title="Open AI Book Assistant">

    <span class="ai-robot-icon">🤖</span>

    <span class="ai-assistant-text">
        AI Assistant
    </span>
</a>


<footer class="booknest-footer">

    <div class="container">

        <div class="row">

            <div class="col-md-6">

                <h5 class="fw-bold">
                    <i class="bi bi-book-half me-2"></i>
                    BookNest
                </h5>

                <p class="text-muted mb-0">
                    Your online bookstore for discovering,
                    buying and managing books.
                </p>

            </div>

            <div class="col-md-6 text-md-end mt-3 mt-md-0">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-decoration-none me-3">

                    Store

                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="text-decoration-none me-3">

                    Login

                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="text-decoration-none">

                    Register

                </a>

            </div>

        </div>

        <hr />

        <div class="text-center text-muted small">

            © @DateTime.Now.Year BookNest. All rights reserved.

        </div>

    </div>

</footer>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js"
        asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>