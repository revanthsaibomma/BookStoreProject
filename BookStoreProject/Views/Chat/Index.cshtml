<script>

    const moodInput = document.getElementById("moodInput");
    const sendBtn = document.getElementById("sendBtn");
    const chatContent = document.getElementById("chatContent");
    const loading = document.getElementById("aiLoading");
    const welcomeMessage = document.getElementById("welcomeMessage");
    const suggestions = document.getElementById("suggestions");

    const askUrl = '@Url.Action("Ask", "Chat")';


    function setMood(text) {

        if (!moodInput)
            return;

        moodInput.value = text;
        moodInput.focus();
    }


    function escapeHtml(text) {

        const div = document.createElement("div");

        div.textContent = text ?? "";

        return div.innerHTML;
    }


    function addUserMessage(text) {

        const row = document.createElement("div");

        row.className = "ai-message ai-user-message";

        row.innerHTML = `
                <div class="ai-message-bubble">
                    ${escapeHtml(text)}
                </div>
            `;

        chatContent.appendChild(row);

        scrollToBottom();
    }


    function addAIMessage(text) {

        const row = document.createElement("div");

        row.className = "ai-message ai-bot-message";

        row.innerHTML = `
                <div class="ai-bot-small-avatar">
                    🤖
                </div>

                <div class="ai-message-bubble">
                    ${escapeHtml(text)}
                </div>
            `;

        chatContent.appendChild(row);

        scrollToBottom();
    }


    function addRecommendations(books) {

        if (!books || books.length === 0)
            return;


        const section = document.createElement("div");

        section.className = "ai-recommendations";


        books.forEach(book => {

            const card = document.createElement("div");

            card.className = "ai-recommendation-card";


            let imageHtml = "";

            if (book.image) {

                imageHtml = `
                        <img src="${escapeHtml(book.image)}"
                             alt="${escapeHtml(book.name)}"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">

                        <div class="ai-book-placeholder"
                             style="display:none;">
                            <i class="bi bi-book"></i>
                        </div>
                    `;

            }
            else {

                imageHtml = `
                        <div class="ai-book-placeholder">
                            <i class="bi bi-book"></i>
                        </div>
                    `;
            }


            card.innerHTML = `

                    <div class="ai-book-image">
                        ${imageHtml}
                    </div>

                    <div class="ai-book-info">

                        <span class="ai-book-genre">
                            ${escapeHtml(book.genre ?? "Book")}
                        </span>

                        <h4>
                            ${escapeHtml(book.name ?? "Unknown Book")}
                        </h4>

                        <p class="ai-book-author">
                            ${escapeHtml(book.author ?? "")}
                        </p>

                        <p class="ai-book-description">
                            ${escapeHtml(book.description ?? "")}
                        </p>

                        <div class="ai-book-bottom">

                            <strong>
                                ₹${book.price ?? ""}
                            </strong>

                            <a href="/Home/Detail/${book.id}"
                               class="ai-view-book">
                                View Book
                                <i class="bi bi-arrow-right"></i>
                            </a>

                        </div>

                    </div>
                `;


            section.appendChild(card);

        });


        chatContent.appendChild(section);

        scrollToBottom();
    }


    async function askAssistant() {

        const mood = moodInput.value.trim();


        if (!mood) {

            moodInput.focus();

            return;
        }


        // Remove welcome content after first question
        if (welcomeMessage) {
            welcomeMessage.style.display = "none";
        }

        if (suggestions) {
            suggestions.style.display = "none";
        }


        addUserMessage(mood);


        moodInput.value = "";

        sendBtn.disabled = true;

        loading.classList.add("show");


        try {

            const response = await fetch(askUrl, {

                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    mood: mood
                })

            });


            const data = await response.json();


            if (!response.ok) {

                throw new Error(
                    data.message || "Unable to contact AI."
                );

            }


            if (data.success) {

                addAIMessage(
                    data.message ||
                    "Here are some books you might enjoy."
                );

                addRecommendations(data.books);

            }
            else {

                addAIMessage(
                    data.message ||
                    "I couldn't find any recommendations."
                );

            }

        }
        catch (error) {

            console.error("BookNest AI Error:", error);

            addAIMessage(
                "🤖 Sorry, I couldn't connect to the AI right now. Please try again."
            );

        }
        finally {

            loading.classList.remove("show");

            sendBtn.disabled = false;

            moodInput.focus();

        }

    }


    function scrollToBottom() {

        if (!chatContent)
            return;


        chatContent.scrollTo({

            top: chatContent.scrollHeight,

            behavior: "smooth"

        });

    }


    sendBtn.addEventListener(
        "click",
        askAssistant
    );


    moodInput.addEventListener(
        "keydown",
        function(event) {

            if (event.key === "Enter") {

                event.preventDefault();

                askAssistant();

            }

        }
    );

</script>