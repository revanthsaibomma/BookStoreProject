@{
    ViewData["Title"] = "Order Management";
}

<style>
    .order-home {
        min-height: calc(100vh - 70px);
        background: #f6f7fb;
        padding: 40px 25px;
    }

    .order-container {
        max-width: 1100px;
        margin: auto;
    }

    .hero-card {
        background: linear-gradient(135deg, #312e81, #4f46e5);
        color: white;
        border-radius: 20px;
        padding: 45px;
        position: relative;
        overflow: hidden;
        margin-bottom: 25px;
    }

        .hero-card::after {
            content: "";
            position: absolute;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            right: -60px;
            top: -70px;
        }

        .hero-card h1 {
            margin: 0;
            font-size: 32px;
            font-weight: 750;
            position: relative;
            z-index: 1;
        }

        .hero-card p {
            margin: 10px 0 25px;
            color: #e0e7ff;
            max-width: 550px;
            line-height: 1.6;
            position: relative;
            z-index: 1;
        }

    .manage-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 10px;
        background: white;
        color: #4338ca;
        text-decoration: none;
        font-weight: 700;
        position: relative;
        z-index: 1;
    }

        .manage-btn:hover {
            background: #f8fafc;
            color: #3730a3;
        }

    .features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .feature-card {
        background: white;
        border: 1px solid #e8ebf2;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 5px 20px rgba(20,30,50,.04);
    }

    .feature-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #eef2ff;
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        margin-bottom: 18px;
    }

    .feature-card h3 {
        font-size: 17px;
        color: #263044;
        margin-bottom: 7px;
    }

    .feature-card p {
        color: #7a8497;
        font-size: 13px;
        line-height: 1.6;
        margin: 0;
    }

    @@media(max-width:700px) {
        .order-home {
            padding: 20px 15px;
        }

        .hero-card {
            padding: 30px 25px;
        }

            .hero-card h1 {
                font-size: 27px;
            }

        .features {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="order-home">

    <div class="order-container">

        <div class="hero-card">

            <h1>
                Order Management
            </h1>

            <p>
                View customer orders, track order progress,
                and update delivery status from one convenient place.
            </p>

            <a asp-action="AdminManageOrders"
               class="manage-btn">

                <i class="bi bi-box-seam"></i>

                View All Orders

            </a>

        </div>


        <div class="features">

            <div class="feature-card">

                <div class="feature-icon">
                    <i class="bi bi-list-check"></i>
                </div>

                <h3>View Orders</h3>

                <p>
                    Browse all customer orders and
                    review their details.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    <i class="bi bi-arrow-repeat"></i>
                </div>

                <h3>Update Status</h3>

                <p>
                    Change orders between Pending,
                    Shipped, Delivered and Cancelled.
                </p>

            </div>


            <div class="feature-card">

                <div class="feature-icon">
                    <i class="bi bi-person-check"></i>
                </div>

                <h3>Customer Orders</h3>

                <p>
                    Keep track of customer information
                    and purchased books.
                </p>

            </div>

        </div>

    </div>

</div>