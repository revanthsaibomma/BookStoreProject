@model IEnumerable<BookStoreProject.DTOs.OrderDto>

@{
    ViewData["Title"] = "Manage Orders";
}

<style>
    .orders-page {
        background: #f6f7fb;
        min-height: calc(100vh - 70px);
        padding: 30px;
    }

    .orders-container {
        max-width: 1400px;
        margin: auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-title h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 750;
        color: #172033;
    }

    .page-title p {
        margin-top: 7px;
        color: #7a8497;
        font-size: 14px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: white;
        border: 1px solid #e1e5ec;
        color: #475569;
        text-decoration: none;
        padding: 10px 16px;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 600;
    }

        .back-btn:hover {
            background: #f8fafc;
            color: #4f46e5;
        }

    .summary-bar {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-bottom: 20px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e8ebf2;
        border-radius: 13px;
        padding: 18px 20px;
    }

    .summary-label {
        color: #7a8497;
        font-size: 12px;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: .4px;
    }

    .summary-value {
        font-size: 23px;
        font-weight: 750;
        color: #263044;
        margin-top: 5px;
    }

    .orders-card {
        background: white;
        border: 1px solid #e8ebf2;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(20,30,50,.04);
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .orders-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1050px;
    }

        .orders-table thead {
            background: #f8f9fc;
        }

        .orders-table th {
            text-align: left;
            padding: 16px 18px;
            color: #7b8495;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
            border-bottom: 1px solid #e9edf3;
        }

        .orders-table td {
            padding: 18px;
            border-bottom: 1px solid #eef1f5;
            vertical-align: top;
        }

        .orders-table tbody tr:hover {
            background: #fafbff;
        }

    .order-id {
        font-weight: 750;
        color: #4f46e5;
    }

    .customer {
        font-weight: 650;
        color: #263044;
    }

    .address {
        color: #8a94a6;
        font-size: 12px;
        margin-top: 4px;
        max-width: 190px;
        line-height: 1.4;
    }

    .date {
        color: #64748b;
        font-size: 13px;
    }

    .payment {
        display: inline-block;
        background: #f1f5f9;
        color: #475569;
        padding: 5px 9px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
    }

    .items {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        color: #475569;
    }

        .item i {
            color: #6366f1;
        }

    .quantity {
        color: #94a3b8;
        font-size: 12px;
    }

    .status-form {
        display: flex;
        gap: 7px;
        align-items: center;
    }

    .status-select {
        height: 36px;
        border: 1px solid #dfe3eb;
        border-radius: 8px;
        padding: 0 8px;
        font-size: 12px;
        color: #475569;
        background: white;
        outline: none;
    }

        .status-select:focus {
            border-color: #6366f1;
        }

    .update-btn {
        width: 36px;
        height: 36px;
        border: none;
        border-radius: 8px;
        background: #4f46e5;
        color: white;
        cursor: pointer;
    }

        .update-btn:hover {
            background: #4338ca;
        }

    .empty-state {
        padding: 70px 20px;
        text-align: center;
    }

        .empty-state i {
            font-size: 50px;
            color: #c5cad4;
        }

        .empty-state h3 {
            color: #475569;
            margin-top: 15px;
        }

        .empty-state p {
            color: #94a3b8;
        }

        .empty-state a {
            display: inline-block;
            margin-top: 10px;
            color: #4f46e5;
            text-decoration: none;
            font-weight: 600;
        }

    @@media(max-width:700px) {
        .orders-page {
            padding: 15px;
        }

        .page-header {
            align-items: flex-start;
            gap: 15px;
            flex-direction: column;
        }

        .summary-bar {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="orders-page">

    <div class="orders-container">

        <!-- HEADER -->

        <div class="page-header">

            <div class="page-title">

                <h1>Orders</h1>

                <p>
                    Review and manage customer orders.
                </p>

            </div>

            <a asp-action="Index"
               class="back-btn">

                <i class="bi bi-arrow-left"></i>

                Order Dashboard

            </a>

        </div>


        @if (Model != null && Model.Any())
        {
            <!-- SUMMARY -->

            <div class="summary-bar">

                <div class="summary-card">

                    <div class="summary-label">
                        Total Orders
                    </div>

                    <div class="summary-value">
                        @Model.Count()
                    </div>

                </div>


                <div class="summary-card">

                    <div class="summary-label">
                        Items Ordered
                    </div>

                    <div class="summary-value">
                        @Model.Sum(x =>
                            x.OrderDetails?.Sum(d => d.Quantity) ?? 0)
                    </div>

                </div>


                <div class="summary-card">

                    <div class="summary-label">
                        Pending Orders
                    </div>

                    <div class="summary-value">

                        @Model.Count(x =>
                            x.StatusName != null &&
                            x.StatusName.Equals(
                                "Pending",
                                StringComparison.OrdinalIgnoreCase))

                    </div>

                </div>

            </div>


            <!-- ORDERS -->

            <div class="orders-card">

                <div class="table-wrapper">

                    <table class="orders-table">

                        <thead>

                            <tr>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Items</th>
                                <th>Payment</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var order in Model)
                            {
                                <tr>

                                    <!-- ORDER -->

                                    <td>

                                        <div class="order-id">
                                            #@order.Id
                                        </div>

                                    </td>


                                    <!-- CUSTOMER -->

                                    <td>

                                        <div class="customer">
                                            @order.Name
                                        </div>

                                        <div class="address">
                                            @order.Address
                                        </div>

                                        <div class="address">
                                            @order.PhoneNumber
                                        </div>

                                    </td>


                                    <!-- DATE -->

                                    <td>

                                        <div class="date">

                                            @order.CreateDate.ToLocalTime()
                                            .ToString("dd MMM yyyy")

                                        </div>

                                        <div class="date">

                                            @order.CreateDate.ToLocalTime()
                                            .ToString("hh:mm tt")

                                        </div>

                                    </td>


                                    <!-- ITEMS -->

                                    <td>

                                        <div class="items">

                                            @if (order.OrderDetails != null &&
                                                 order.OrderDetails.Any())
                                            {
                                                foreach (var item in order.OrderDetails)
                                                {
                                                    <div class="item">

                                                        <i class="bi bi-book"></i>

                                                        <span>
                                                            @item.BookName
                                                        </span>

                                                        <span class="quantity">
                                                            × @item.Quantity
                                                        </span>

                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="quantity">
                                                    No items
                                                </span>
                                            }

                                        </div>

                                    </td>


                                    <!-- PAYMENT -->

                                    <td>

                                        <span class="payment">
                                            @order.PaymentMode
                                        </span>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        <form asp-action="UpdateStatus"
                                              method="post"
                                              class="status-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="orderId"
                                                   value="@order.Id" />

                                            <select name="statusId"
                                                    class="status-select">

                                                <option value="1"
                                                        selected="@(order.OrderStatusId == 1)">
                                                    Pending
                                                </option>

                                                <option value="2"
                                                        selected="@(order.OrderStatusId == 2)">
                                                    Shipped
                                                </option>

                                                <option value="3"
                                                        selected="@(order.OrderStatusId == 3)">
                                                    Delivered
                                                </option>

                                                <option value="4"
                                                        selected="@(order.OrderStatusId == 4)">
                                                    Cancelled
                                                </option>

                                            </select>

                                            <button type="submit"
                                                    class="update-btn"
                                                    title="Update Status">

                                                <i class="bi bi-check-lg"></i>

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        }
        else
        {
            <div class="orders-card">

                <div class="empty-state">

                    <i class="bi bi-inbox"></i>

                    <h3>No orders yet</h3>

                    <p>
                        Customer orders will appear here once
                        they start placing orders.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Index">

                        Return to Dashboard

                    </a>

                </div>

            </div>
        }

    </div>

</div>