@model IEnumerable<BookStoreProject.DTOs.GenreDto>

@{
    ViewData["Title"] = "Manage Genres";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Manage Genres</h1>
            <p class="text-muted mb-0">
                Create and manage your bookstore genres.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Genre
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>ID</th>
                                <th>Genre Name</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var genre in Model)
                            {
                                <tr>
                                    <td>@genre.Id</td>

                                    <td>
                                        <span class="fw-semibold">
                                            @genre.GenreName
                                        </span>
                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Edit"
                                           asp-route-id="@genre.Id"
                                           class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@genre.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-tags fs-1 text-muted"></i>

                    <h4 class="mt-3">
                        No genres available
                    </h4>

                    <p class="text-muted">
                        Create your first bookstore genre.
                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">
                        Add Genre
                    </a>

                </div>
            }

        </div>
    </div>

</div>