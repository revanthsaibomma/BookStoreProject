@page
@model ChangePasswordModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="password-page">

    <div class="password-container">

        <!-- Page Header -->
        <div class="password-header">

            <div class="password-icon">
                <i class="bi bi-shield-lock"></i>
            </div>

            <div>
                <span class="password-label">ACCOUNT SECURITY</span>

                <h1>Change Password</h1>

                <p>
                    Update your password to keep your BookNest account secure.
                </p>
            </div>

        </div>


        <!-- Password Card -->
        <div class="password-card">

            <div class="password-card-header">

                <div>
                    <h2>Update your password</h2>

                    <p>
                        Enter your current password and choose a new one.
                    </p>
                </div>

                <div class="password-card-icon">
                    <i class="bi bi-key"></i>
                </div>

            </div>


            <form id="change-password-form"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="password-validation"
                     role="alert">
                </div>


                <!-- Current Password -->
                <div class="password-field">

                    <label asp-for="Input.OldPassword">

                        <i class="bi bi-lock"></i>

                        Current Password

                    </label>

                    <div class="password-input-wrapper">

                        <input asp-for="Input.OldPassword"
                               class="password-input"
                               autocomplete="current-password"
                               placeholder="Enter your current password" />

                        <i class="bi bi-lock-fill password-input-icon"></i>

                    </div>

                    <span asp-validation-for="Input.OldPassword"
                          class="password-error">
                    </span>

                </div>


                <!-- New Password -->
                <div class="password-field">

                    <label asp-for="Input.NewPassword">

                        <i class="bi bi-shield-lock"></i>

                        New Password

                    </label>

                    <div class="password-input-wrapper">

                        <input asp-for="Input.NewPassword"
                               class="password-input"
                               autocomplete="new-password"
                               placeholder="Enter your new password" />

                        <i class="bi bi-key-fill password-input-icon"></i>

                    </div>

                    <span asp-validation-for="Input.NewPassword"
                          class="password-error">
                    </span>

                </div>


                <!-- Confirm Password -->
                <div class="password-field">

                    <label asp-for="Input.ConfirmPassword">

                        <i class="bi bi-check-circle"></i>

                        Confirm New Password

                    </label>

                    <div class="password-input-wrapper">

                        <input asp-for="Input.ConfirmPassword"
                               class="password-input"
                               autocomplete="new-password"
                               placeholder="Confirm your new password" />

                        <i class="bi bi-check-circle-fill password-input-icon"></i>

                    </div>

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="password-error">
                    </span>

                </div>


                <!-- Password Tip -->
                <div class="password-tip">

                    <div class="password-tip-icon">
                        <i class="bi bi-lightbulb"></i>
                    </div>

                    <div>
                        <strong>Password tip</strong>

                        <p>
                            Use a strong password that you don't use on other websites.
                        </p>
                    </div>

                </div>


                <!-- Buttons -->
                <div class="password-actions">

                    <a asp-page="./Index"
                       class="password-cancel-btn">

                        <i class="bi bi-arrow-left"></i>

                        Back to Profile

                    </a>

                    <button id="update-password-button"
                            type="submit"
                            class="password-save-btn">

                        <i class="bi bi-shield-check"></i>

                        Update Password

                    </button>

                </div>

            </form>

        </div>


        <!-- Security Information -->
        <div class="security-note">

            <div class="security-note-icon">
                <i class="bi bi-shield-check"></i>
            </div>

            <div>
                <h3>Your account is protected</h3>

                <p>
                    Changing your password regularly helps keep your
                    BookNest account secure.
                </p>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}