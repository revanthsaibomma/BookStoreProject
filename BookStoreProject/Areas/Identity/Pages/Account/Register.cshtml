<div class="auth-page">

    <div class="auth-card">

        <!-- LEFT SIDE -->
        <div class="auth-content">

            <div class="auth-icon">
                📖
            </div>

            <h1>Join BookNest</h1>

            <p class="auth-subtitle">
                Create your account and start exploring amazing books.
            </p>

            <form id="registerForm"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"
                     role="alert">
                </div>

                <div class="auth-input-group">

                    <label asp-for="Input.Email">
                        Email Address
                    </label>

                    <input asp-for="Input.Email"
                           class="auth-input"
                           autocomplete="username"
                           placeholder="Enter your email" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>

                </div>


                <div class="auth-input-group">

                    <label asp-for="Input.Password">
                        Password
                    </label>

                    <input asp-for="Input.Password"
                           class="auth-input"
                           autocomplete="new-password"
                           placeholder="Create a password" />

                    <span asp-validation-for="Input.Password"
                          class="text-danger">
                    </span>

                </div>


                <div class="auth-input-group">

                    <label asp-for="Input.ConfirmPassword">
                        Confirm Password
                    </label>

                    <input asp-for="Input.ConfirmPassword"
                           class="auth-input"
                           autocomplete="new-password"
                           placeholder="Confirm your password" />

                    <span asp-validation-for="Input.ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>


                <button id="registerSubmit"
                        type="submit"
                        class="auth-submit">
                    Create Account
                </button>

            </form>


            <div class="auth-links">

                <p>
                    Already have an account?

                    <a asp-page="./Login"
                       asp-route-returnUrl="@Model.ReturnUrl">
                        Sign in
                    </a>
                </p>

            </div>

        </div>


        <!-- RIGHT SIDE -->
        <div class="auth-showcase">

            <div class="showcase-circle circle-one"></div>
            <div class="showcase-circle circle-two"></div>

            <div class="book-decoration">
                ✨
            </div>

            <h2>
                Your next favorite<br />
                book is waiting.
            </h2>

            <p>
                Build your personal collection and
                discover stories worth remembering.
            </p>

            <div class="showcase-books">
                <span>📕</span>
                <span>📘</span>
                <span>📗</span>
                <span>📙</span>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}